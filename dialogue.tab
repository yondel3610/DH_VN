ch7_waiting_common_e35f01e1		Niko folded his arms, his gaze sharp and skeptical.	game/09_chapter_07.rpy	1126	"[what]"
ch7_waiting_common_b872709a	niko	How sure are you? There might still be some yaoguai lurking.	game/09_chapter_07.rpy	1128	niko "[what]"
