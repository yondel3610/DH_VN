ch8_magnus_end_20d56988		He gasped—his eyes wide, his mouth moving soundlessly—	game/10_chapter_08.rpy	1934	"[what]"
ch8_magnus_end_79752148	niko	Urgh- Ah… Lord Enoch…	game/10_chapter_08.rpy	1936	niko "[what]"
ch8_magnus_end_27e69441	svante	No, no, no—!	game/10_chapter_08.rpy	1938	svante "[what]"
